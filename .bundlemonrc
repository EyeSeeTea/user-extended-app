{
    "baseDir": "./build",
    "groups": [
        {
            "path": "./**/*",
            "friendlyName": "Build Folder",
            "compression": "gzip",
            // Max size of the build folder
            "maxSize": "2 MB",
            // Max percent increase of the build folder for new PRs
            "maxPercentIncrease": "20"
        }
    ],
    "reportOutput": [
        [
            "github",
            {
                "checkRun": true,
                "commitStatus": true,
                "prComment": true
            }
        ]
    ]
}
