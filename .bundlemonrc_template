{
    "baseDir": "./build",
    "files": [
        {
            "path": "./*.zip",
            "friendlyName": "Build ZIP",
            "compression": "none",
            "maxSize": "3 MB",
            "maxPercentIncrease": 25
        },
        {
            "path": "./static/js/main.<hash>.chunk.js",
            "friendlyName": "Index",
            "compression": "gzip"
        },
        {
            "path": "./**/*.{$build_file_types}",
            "friendlyName": "Build Folder Files",
            "compression": "gzip"
        }
    ],
    "groups": [
        {
            "path": "./**/*.{$build_file_types}",
            "friendlyName": "Build Folder",
            "compression": "gzip",
            "maxSize": "3 MB",
            "maxPercentIncrease": 25
        }
    ],
    "reportOutput": [
        [
            "github",
            {
                "checkRun": true,
                "commitStatus": true,
                "prComment": true
            }
        ]
    ]
}
